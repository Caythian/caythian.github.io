---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Starter from "../../components/Starter.astro";
import StaticArtworkGallery from "../../components/StaticArtworkGallery";
import Layout from "../../layouts/Layout.astro";
import { generateSlug } from "../../lib/utils";
import type { Artwork, ArtworkRow } from "../../types";

const artworksCollection = await getCollection("artworks");
const seriesCollection = await getCollection("series");

type ArtworkEntry = (typeof artworksCollection)[number];

const toArtwork = async (entry: ArtworkEntry): Promise<Artwork> => ({
  id: entry.id,
  slug: generateSlug(entry.data.title, entry.id),
  title: entry.data.title,
  time: entry.data.time,
  medium: entry.data.medium,
  dimension: entry.data.dimension,
  description: entry.data.description?.filter((line) => line.trim()),
  // The main image followed by its detail images, each with a small thumbnail
  images: await Promise.all(
    [entry.data.image, ...(entry.data.details ?? [])]
      .filter((image) => image?.src)
      .map(async (image) => ({
        src: image.src,
        thumb: (await getImage({ src: image, width: 160 })).src,
      })),
  ),
});

const byTitle = (a: ArtworkEntry, b: ArtworkEntry) =>
  a.data.title.localeCompare(b.data.title, undefined, {
    sensitivity: "base",
    numeric: true,
  });

const yearOf = (entry: ArtworkEntry) =>
  Number.parseInt(entry.data.time ?? "", 10);

const yearSpan = (entries: ArtworkEntry[]) => {
  const years = entries.map(yearOf).filter(Number.isFinite);
  if (years.length === 0) return { first: 0, last: 0 };
  return { first: Math.min(...years), last: Math.max(...years) };
};

// Finished: "2025", or "2024–2025" across several years. Ongoing: "2025–"
const formatYears = (
  { first, last }: { first: number; last: number },
  status: "ongoing" | "finished",
) => {
  if (!first) return undefined;
  if (status === "ongoing") return `${first}–`;
  return first === last ? String(first) : `${first}–${last}`;
};

// Each row with the years it spans and whether it's ongoing, for sorting
const rows: (ArtworkRow & {
  span: { first: number; last: number };
  ongoing: boolean;
})[] = [];

for (const series of seriesCollection) {
  const entries = artworksCollection
    .filter((entry) => entry.data.series?.id === series.id)
    .sort(byTitle);
  if (entries.length === 0) continue;

  const coverEntry =
    entries.find((entry) => entry.id === series.data.cover?.id) ?? entries[0];

  const span = yearSpan(entries);
  rows.push({
    id: series.id,
    title: series.data.title,
    category: series.data.category,
    span,
    ongoing: series.data.status === "ongoing",
    years: formatYears(span, series.data.status),
    summary: series.data.summary,
    cover: coverEntry.data.image.src,
    pieces: await Promise.all(entries.map(toArtwork)),
  });
}

for (const entry of artworksCollection) {
  if (entry.data.series) continue;
  const span = yearSpan([entry]);
  rows.push({
    id: entry.id,
    title: entry.data.title,
    category: entry.data.category,
    span,
    ongoing: entry.data.status === "ongoing",
    years: formatYears(span, entry.data.status),
    summary: entry.data.summary,
    cover: entry.data.image.src,
    pieces: [await toArtwork(entry)],
  });
}

// Ongoing work first, then newest first: by the latest year in each row,
// then the earliest, then title
rows.sort(
  (a, b) =>
    Number(b.ongoing) - Number(a.ongoing) ||
    b.span.last - a.span.last ||
    b.span.first - a.span.first ||
    a.title.localeCompare(b.title, undefined, { sensitivity: "base" }),
);
---

<Layout title="Artworks - Xuecong Wang">
  <Starter />
  <StaticArtworkGallery rows={rows.map(({ span, ongoing, ...row }) => row)} client:load />
</Layout>
