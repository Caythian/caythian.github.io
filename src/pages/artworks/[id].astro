---
import { getCollection } from "astro:content";
import { generateSlug } from "../../lib/utils";

export async function getStaticPaths() {
  const artworks = await getCollection("artworks");
  return artworks.map((entry) => ({
    params: { id: generateSlug(entry.data.title, entry.id) },
    props: { title: entry.data.title },
  }));
}

// Artworks are shown in the viewer on the artworks page; keep old links working
const { title } = Astro.props;
const target = `/artworks?artwork=${Astro.params.id}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} - Xuecong Wang</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <a href={target}>{title}</a>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
